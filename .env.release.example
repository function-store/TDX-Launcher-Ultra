# Per-machine release secrets. Copy to `.env.release` (gitignored) on each
# release machine and fill in. `npm run release:build` / `release:ship` /
# `release:publish` read it automatically; anything already exported in the
# shell takes precedence. Plain KEY=VALUE lines, quotes optional.

# Required to publish (both machines). Account-level "Workers R2 Storage: Edit"
# token from My Profile -> API Tokens -> Custom Token -- NOT the R2 page's
# "Manage R2 API Tokens" flow, which wrangler rejects with a 403.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional. Bucket defaults to tdxgl-releases.
# R2_BUCKET=tdxgl-releases

# Optional. Updater private key: a path or the key contents. Without it the
# build script looks in ~/.tauri/tdxlpp_updater.key (then ~/Downloads).
# TAURI_SIGNING_PRIVATE_KEY=C:/Users/you/.tauri/tdxlpp_updater.key

# macOS only, for notarization (same values as scripts/local-signing-env.sh).
# APPLE_SIGNING_IDENTITY=Developer ID Application: Daniel Molnar (Y23BK46GL6)
# APPLE_TEAM_ID=Y23BK46GL6
# APPLE_API_KEY=F32234AD4S
# APPLE_API_ISSUER=73d88e55-d908-4b0c-9cfe-29270a50169e
# APPLE_API_KEY_PATH=/Users/you/.appstoreconnect/private_keys/AuthKey_F32234AD4S.p8
