# Tauri
src-tauri/target
src-tauri/gen
/installers

# Local-only signing/notarization env vars -- never commit real key material
/scripts/local-signing-env.sh
# Per-machine release secrets (Cloudflare token etc.), read by the release scripts
/.env.release

# Build outputs (demo and main app builds)
/website/demo

# Staged R2 release tree (scripts/prepare-*.mjs) and downloaded CI bundles
/dist-release
/artifacts

# Embody Releaseall export destination. The shipped companion TOX is tracked
# right here; sibling exports (TDXLUSensors.tox, …) are staging noise.
/release/*
!/release/TDXLauncherUtility.tox
# The FNSTools bootstrap the launcher bundles stays OUT of git: it is fetched
# from the release bucket at build time and sha-verified
# (scripts/fetch-fns-bootstrap.mjs, wired into tauri:build / release:prepare).
# Committing it invites shipping a hand-copied dev build. The RECORD of which
# release was fetched is tracked instead, so "what does this installer carry?"
# is answerable from git alone.
!/release/FNSTools.json
# Bundled capability artifacts (free + launcher-capable only) — fetched and
# digest-verified at build time by the same script. Never committed: a gated
# package must never reach a public installer via a stale local copy.
/release/fns/

